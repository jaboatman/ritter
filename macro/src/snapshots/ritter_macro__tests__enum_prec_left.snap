                                            false,
                                            |state| match state {
                                                0u32 => ::ritter::extract::ExtractFieldState::Str(
                                                    "-", false, false,
                                                ),
                                                1u32 => {
                                                    ::ritter::extract::ExtractFieldState::Complete
                                                }
                                                _ => ::ritter::extract::ExtractFieldState::Overflow,
                                            },
                                        ),
                                        source,
